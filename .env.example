# --- Database -------------------------------------------------------------
# Application connection: role keel_app, subject to Row Level Security.
DATABASE_URL=postgres://keel_app:keel_app@127.0.0.1:5432/keel
# Administrative connection: superuser or role keel_admin (BYPASSRLS). Used by
# migrations, the seed, the job runner bootstrap and the super-admin console.
DATABASE_ADMIN_URL=postgres://keel_admin:keel_admin@127.0.0.1:5432/keel
# Test database (same roles), used by vitest integration tests.
TEST_DATABASE_ADMIN_URL=postgres://keel_admin:keel_admin@127.0.0.1:5432/keel_test
TEST_DATABASE_URL=postgres://keel_app:keel_app@127.0.0.1:5432/keel_test

# Hosted databases: passwords given to the two roles by `pnpm db:bootstrap` (defaults match the URLs above),
# superuser used by bootstrap, databases to create (set KEEL_DATABASES=keel on a hosted instance).
KEEL_ADMIN_PASSWORD=
KEEL_APP_PASSWORD=
DATABASE_SUPERUSER_URL=
KEEL_DATABASES=
# Password of the seeded demo users (default keel-demo-2026).
KEEL_DEMO_PASSWORD=

# --- Auth -----------------------------------------------------------------
AUTH_SECRET=dev-only-change-me-please-32-bytes-min
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Crypto ---------------------------------------------------------------
# 32 bytes, base64. Used to encrypt integration credentials at rest (AES-GCM).
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# --- Integrations ---------------------------------------------------------
# mock | live. In mock mode no network call ever leaves the process.
KEEL_INTEGRATION_MODE=mock

# --- Platform email (optional; issue #51) -----------------------------------
# One sender owned by the platform. Resend is used only when RESEND_API_KEY is set AND
# KEEL_INTEGRATION_MODE=live; otherwise emails are captured by the mock (dev inbox at /dev/emails in
# development) and the console (/admin/email) says "Email not configured". Never commit a real key.
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook pointing at /api/webhooks/email.
RESEND_WEBHOOK_SECRET=
# Sender on the verified domain, e.g. "Keel <no-reply@mail.example.com>", and the reply-to mailbox.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Footer of every email: legal sender details and support address (defaults: product name, EMAIL_REPLY_TO).
EMAIL_LEGAL_NAME=
EMAIL_LEGAL_ADDRESS=
EMAIL_SUPPORT_ADDRESS=

# --- Billing (optional) ---------------------------------------------------
# When STRIPE_SECRET_KEY is set the StripeBillingProvider (test mode) is used;
# otherwise MockBillingProvider.
STRIPE_SECRET_KEY=

# --- Shopify public app (optional; custom-app tokens work without these) ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# --- Jobs ---------------------------------------------------------------------
# Set to 1 when the job runner (packages/jobs) is deployed: webhooks and resyncs are then queued
# through pg-boss instead of running inline after the response. Required with KEEL_INTEGRATION_MODE=live:
# web and worker refuse to start without it (packages/config/src/runtime.ts).
KEEL_JOBS_QUEUE=

# --- Error tracking (optional) ------------------------------------------------
# Sentry is off unless a DSN is set. Errors only, no tracing, no personal data.
# NEXT_PUBLIC_SENTRY_DSN is read at build time (browser errors): set it before building.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
