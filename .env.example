# --- Database -------------------------------------------------------------
# Application connection: role keel_app, subject to Row Level Security.
DATABASE_URL=postgres://keel_app:keel_app@127.0.0.1:5432/keel
# Administrative connection: superuser or role keel_admin (BYPASSRLS). Used by
# migrations, the seed, the job runner bootstrap and the super-admin console.
DATABASE_ADMIN_URL=postgres://keel_admin:keel_admin@127.0.0.1:5432/keel
# Test database (same roles), used by vitest integration tests.
TEST_DATABASE_ADMIN_URL=postgres://keel_admin:keel_admin@127.0.0.1:5432/keel_test
TEST_DATABASE_URL=postgres://keel_app:keel_app@127.0.0.1:5432/keel_test

# --- Auth -----------------------------------------------------------------
AUTH_SECRET=dev-only-change-me-please-32-bytes-min
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Crypto ---------------------------------------------------------------
# 32 bytes, base64. Used to encrypt integration credentials at rest (AES-GCM).
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXMhIQ==

# --- Integrations ---------------------------------------------------------
# mock | live. In mock mode no network call ever leaves the process.
KEEL_INTEGRATION_MODE=mock

# --- Billing (optional) ---------------------------------------------------
# When STRIPE_SECRET_KEY is set the StripeBillingProvider (test mode) is used;
# otherwise MockBillingProvider.
STRIPE_SECRET_KEY=
