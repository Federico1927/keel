# --- Database -------------------------------------------------------------
# Application connection: role hullwise_app, subject to Row Level Security.
DATABASE_URL=postgres://hullwise_app:hullwise_app@127.0.0.1:5432/hullwise
# Administrative connection: superuser or role hullwise_admin (BYPASSRLS). Used by
# migrations, the seed, the job runner bootstrap and the super-admin console.
DATABASE_ADMIN_URL=postgres://hullwise_admin:hullwise_admin@127.0.0.1:5432/hullwise
# Test database (same roles), used by vitest integration tests.
TEST_DATABASE_ADMIN_URL=postgres://hullwise_admin:hullwise_admin@127.0.0.1:5432/hullwise_test
TEST_DATABASE_URL=postgres://hullwise_app:hullwise_app@127.0.0.1:5432/hullwise_test

# Hosted databases: passwords given to the two roles by `pnpm db:bootstrap` (defaults match the URLs above),
# superuser used by bootstrap, databases to create (set HULLWISE_DATABASES=hullwise on a hosted instance).
HULLWISE_ADMIN_PASSWORD=
HULLWISE_APP_PASSWORD=
DATABASE_SUPERUSER_URL=
HULLWISE_DATABASES=
# Password of the seeded demo users (default hullwise-demo-2026).
HULLWISE_DEMO_PASSWORD=

# --- Public URLs ------------------------------------------------------------
# Every absolute link (emails, OAuth callbacks, webhooks, MCP, pixel) is built from these; no domain is
# hardcoded. Locally only APP_URL is needed: the console falls back to APP_URL/admin and the API to
# APP_URL/api. Production values (docs/DEPLOY.md):
#   NEXT_PUBLIC_SITE_URL=https://hullwise.app      landing
#   APP_URL=https://my.hullwise.app                tenant app
#   ADMIN_URL=https://admin.hullwise.app           super-admin console (also served at APP_URL/admin)
#   API_URL=https://api.hullwise.app               webhooks, OAuth callbacks, MCP (https://api.hullwise.app/mcp)
#   COOKIE_DOMAIN=.hullwise.app                    session shared by the three hosts (required with ADMIN_URL/API_URL)
APP_URL=http://localhost:3000
ADMIN_URL=
API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3100
COOKIE_DOMAIN=
# Browser-side copy of APP_URL (read at build time); keep it equal to APP_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth -----------------------------------------------------------------
AUTH_SECRET=dev-only-change-me-please-32-bytes-min
# Auth.js base URL: the app host (APP_URL).
AUTH_URL=http://localhost:3000

# --- Crypto ---------------------------------------------------------------
# 32 bytes, base64. Used to encrypt integration credentials at rest (AES-GCM).
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
# MCP server (#21): pepper of the HMAC that stores MCP tokens (defaults to one derived from AUTH_SECRET;
# set it in production and never change it, or every token stops working). HULLWISE_MCP_DISABLED=1 refuses every MCP call.
# MCP_TOKEN_PEPPER=
# HULLWISE_MCP_DISABLED=
# Public REST API and webhooks (#81): HULLWISE_API_DISABLED=1 refuses every API call.
# HULLWISE_WEBHOOKS_ALLOW_LOOPBACK=1 lets webhooks reach http://127.0.0.1 test receivers (tests and
# the e2e server only; ignored in live mode). Private and metadata addresses are never allowed.
# HULLWISE_API_DISABLED=
# HULLWISE_WEBHOOKS_ALLOW_LOOPBACK=

# --- Integrations ---------------------------------------------------------
# mock | live. In mock mode no network call ever leaves the process.
HULLWISE_INTEGRATION_MODE=mock
# GA4 (#86): the platform's read-only service account. Stores add its e-mail as Viewer on their GA4
# property and paste the property id (the default connection path). KEY is the service account's JSON
# key file (raw JSON or base64); EMAIL is what the card shows (defaults to the key's client_email). Railway
# variables only, never commit a key. Without them, live stores can still use their own service account.
# HULLWISE_GA4_SERVICE_ACCOUNT_EMAIL=
# HULLWISE_GA4_SERVICE_ACCOUNT_KEY=

# --- Platform email (optional; issue #51) -----------------------------------
# One sender owned by the platform. Resend is used only when RESEND_API_KEY is set AND
# HULLWISE_INTEGRATION_MODE=live; otherwise emails are captured by the mock (dev inbox at /dev/emails in
# development) and the console (/admin/email) says "Email not configured". Never commit a real key.
RESEND_API_KEY=
# Signing secret (whsec_...) of the Resend webhook pointing at /api/webhooks/email.
RESEND_WEBHOOK_SECRET=
# Sender on the verified domain, e.g. "Hullwise <no-reply@mail.example.com>", and the reply-to mailbox.
EMAIL_FROM=
EMAIL_REPLY_TO=
# Footer of every email: legal sender details and support address (defaults: product name, EMAIL_REPLY_TO).
EMAIL_LEGAL_NAME=
EMAIL_LEGAL_ADDRESS=
EMAIL_SUPPORT_ADDRESS=

# --- Billing (optional) ---------------------------------------------------
# Stripe billing (#53). Railway variables only: never commit a value. Without
# STRIPE_SECRET_KEY billing runs on the mock (dev, tests, demo). A restricted key
# (rk_test_… / rk_live_…) is enough; the console shows TEST or LIVE from its prefix.
STRIPE_SECRET_KEY=
# Signing secret of the /api/webhooks/stripe endpoint (Stripe dashboard → Webhooks).
STRIPE_WEBHOOK_SECRET=
# off = no Stripe Tax (Hullwise then sets reverse charge itself from verified EU VAT ids).
STRIPE_TAX=
# Country of the company issuing Hullwise's invoices (ISO code), for the VAT treatment.
BILLING_SELLER_COUNTRY=
# mock = push paid invoices to the mock e-invoicing connector (Italian SDI slot).
BILLING_EINVOICING=

# --- Shopify public app (optional; custom-app tokens work without these) ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# --- TikTok for Business app (optional; a store can also connect with its own app id/secret) ---
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
# --- Jobs ---------------------------------------------------------------------
# Set to 1 when the job runner (packages/jobs) is deployed: webhooks and resyncs are then queued
# through pg-boss instead of running inline after the response. Required with HULLWISE_INTEGRATION_MODE=live:
# web and worker refuse to start without it (packages/config/src/runtime.ts).
HULLWISE_JOBS_QUEUE=

# --- Error tracking (optional) ------------------------------------------------
# Sentry is off unless a DSN is set. Errors only, no tracing, no personal data.
# NEXT_PUBLIC_SENTRY_DSN is read at build time (browser errors): set it before building.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
