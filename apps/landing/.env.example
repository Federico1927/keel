# Public site URL, used for canonical links, hreflang, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# External booking link for the "Book a demo" buttons (Calendly, Cal.com, HubSpot...).
# Empty: falls back to a mailto: link to the contact email below.
NEXT_PUBLIC_DEMO_URL=
# Where the "Book a demo" mailto fallback and the contact form fallback go.
NEXT_PUBLIC_CONTACT_EMAIL=federico@automationslab.it
# Webhook that receives the contact form as JSON (POST). The site is static, so the browser
# posts directly: the endpoint must accept cross-origin requests. Empty: the form offers a mailto.
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=
# URL of the Hullwise app, used to link the integration guides (Shopify, Meta, Google).
NEXT_PUBLIC_APP_URL=http://localhost:3000
