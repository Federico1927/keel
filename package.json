{
  "name": "hullwise",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @hullwise/web test:e2e",
    "db:bootstrap": "pnpm --filter @hullwise/db bootstrap",
    "db:generate": "pnpm --filter @hullwise/db generate",
    "db:migrate": "pnpm --filter @hullwise/db migrate",
    "db:seed": "pnpm --filter @hullwise/db seed",
    "db:seed:settings": "pnpm --filter @hullwise/db seed:settings",
    "db:reset": "pnpm --filter @hullwise/db reset",
    "db:rotate-key": "pnpm --filter @hullwise/db rotate-key",
    "db:deploy": "pnpm db:bootstrap && pnpm db:migrate && if [ \"$HULLWISE_SEED_ON_DEPLOY\" = 1 ]; then pnpm db:seed; fi && pnpm db:seed:settings",
    "smoke": "node scripts/smoke.mjs",
    "billing:sync-catalog": "pnpm --filter @hullwise/jobs billing:sync-catalog",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.6.0",
    "turbo": "^2.11.0",
    "typescript": "^5.9.3"
  }
}
