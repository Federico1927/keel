{
  "name": "@hullwise/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed": "./src/seed/index.ts",
    "./test-utils": "./src/test-utils.ts"
  },
  "scripts": {
    "bootstrap": "dotenv -e ../../.env -- tsx src/scripts/bootstrap.ts",
    "generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- tsx src/scripts/migrate.ts",
    "seed": "dotenv -e ../../.env -- tsx src/scripts/seed.ts",
    "seed:settings": "dotenv -e ../../.env -- tsx src/scripts/seed-settings.ts",
    "reset": "dotenv -e ../../.env -- tsx src/scripts/reset.ts",
    "rotate-key": "dotenv -e ../../.env -- tsx src/scripts/rotate-key.ts",
    "studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "dependencies": {
    "@hullwise/config": "workspace:*",
    "@hullwise/core": "workspace:*",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.16.0",
    "@hullwise/integrations": "workspace:*"
  },
  "devDependencies": {
    "@hullwise/eslint-config": "workspace:*",
    "@types/pg": "^8.15.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
