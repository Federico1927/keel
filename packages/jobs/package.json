{
  "name": "@hullwise/jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "start": "dotenv -e ../../.env -- tsx src/worker.ts",
    "billing:sync-catalog": "dotenv -e ../../.env -- tsx src/billing-catalog.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hullwise/addon-cod": "workspace:*",
    "@hullwise/config": "workspace:*",
    "@hullwise/core": "workspace:*",
    "@hullwise/db": "workspace:*",
    "@hullwise/integrations": "workspace:*",
    "@hullwise/services": "workspace:*",
    "@sentry/node": "^11.2.0",
    "pg-boss": "^12.0.0"
  },
  "devDependencies": {
    "@hullwise/eslint-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
