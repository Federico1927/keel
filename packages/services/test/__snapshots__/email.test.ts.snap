}
`;

exports[`templates > every template renders in en, it and es (HTML and text snapshot) > password_reset.en 1`] = `
{
  "html": "<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Reset your Hullwise password</title>
<style>
:root{color-scheme:light dark;supported-color-schemes:light dark}
@media (prefers-color-scheme:dark){
.k-bg{background:#0b0d12!important}
.k-card{background:#12151c!important;border-color:#232836!important}
.k-fg{color:#eef0f5!important}
.k-muted{color:#9aa1b2!important}
.k-link{color:#5b7cff!important}
.k-btn{background:#5b7cff!important;color:#0b0d12!important}
.k-mark{background:#5b7cff!important;color:#0b0d12!important}
.k-quote{border-color:#566285!important;color:#eef0f5!important}
}
</style>
</head>
<body class="k-bg" style="margin:0;padding:0;background:#f7f8fa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif">
<div style="display:none;max-height:0;overflow:hidden;opacity:0">The link expires in 60 minutes.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="k-bg" style="background:#f7f8fa">
<tr><td align="center" style="padding:24px 16px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px">
<tr><td style="padding:0 0 16px">
<table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
<td class="k-mark" width="28" height="28" align="center" style="width:28px;height:28px;background:#2b59ff;color:#ffffff;border-radius:8px;font-size:15px;font-weight:700;line-height:28px">H</td>
<td class="k-fg" style="padding-left:10px;font-size:15px;font-weight:600;color:#0b0d12">Hullwise</td>
</tr></table>
</td></tr>
<tr><td class="k-card" style="background:#ffffff;border:1px solid #e4e7ec;border-radius:8px;padding:24px">
<p class="k-fg" style="margin:0 0 12px;font-size:15px;line-height:1.55;color:#0b0d12">Someone asked to reset the password of your Hullwise account. Choose a new password with this link: it expires in 60 minutes and works once.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:16px 0"><tr><td class="k-btn" style="background:#2b59ff;border-radius:8px"><a class="k-btn" href="https://app.hullwise.example/reset-password/tok" style="display:inline-block;padding:11px 18px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:8px">Choose a new password</a></td></tr></table>
<p class="k-muted" style="margin:0 0 12px;font-size:12px;line-height:1.5;color:#5b6170">If the button does not work, copy this link into your browser:<br><a class="k-link" href="https://app.hullwise.example/reset-password/tok" style="color:#2b59ff;word-break:break-all">https://app.hullwise.example/reset-password/tok</a></p>
<p class="k-muted" style="margin:0;font-size:13px;line-height:1.5;color:#5b6170">If it was not you, ignore this email: your password does not change.</p>
</td></tr>
<tr><td class="k-muted" style="padding:16px 4px 0;font-size:12px;line-height:1.6;color:#5b6170">
This is a security email about your Hullwise account: it is sent even if you turned off other emails.<br>Questions? Write to support@hullwise.example.<br>Hullwise Labs S.r.l. · Via Example 1, 20100 Milano
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>",
  "subject": "Reset your Hullwise password",
  "text": "Someone asked to reset the password of your Hullwise account. Choose a new password with this link: it expires in 60 minutes and works once.

Choose a new password: https://app.hullwise.example/reset-password/tok

If it was not you, ignore this email: your password does not change.

--

This is a security email about your Hullwise account: it is sent even if you turned off other emails.
Questions? Write to support@hullwise.example.
Hullwise Labs S.r.l. · Via Example 1, 20100 Milano",
}
`;

