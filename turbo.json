{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env"
  ],
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_ADMIN_URL",
    "AUTH_SECRET",
    "NEXTAUTH_URL",
    "AUTH_URL",
    "APP_ENCRYPTION_KEY",
    "NODE_ENV",
    "CI",
    "KEEL_INTEGRATION_MODE",
    "STRIPE_SECRET_KEY",
    "NEXT_PUBLIC_APP_URL",
    "KEEL_JOBS_QUEUE",
    "SHOPIFY_API_KEY",
    "SHOPIFY_API_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
