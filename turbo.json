{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_ADMIN_URL",
    "AUTH_SECRET",
    "NEXTAUTH_URL",
    "AUTH_URL",
    "APP_ENCRYPTION_KEY",
    "NODE_ENV",
    "CI",
    "HULLWISE_INTEGRATION_MODE",
    "STRIPE_SECRET_KEY",
    "NEXT_PUBLIC_APP_URL",
    "HULLWISE_JOBS_QUEUE",
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "EMAIL_FROM",
    "EMAIL_REPLY_TO",
    "EMAIL_LEGAL_NAME",
    "EMAIL_LEGAL_ADDRESS",
    "EMAIL_SUPPORT_ADDRESS",
    "SHOPIFY_API_KEY",
    "SHOPIFY_API_SECRET",
    "HULLWISE_DEMO_PASSWORD",
    "HULLWISE_ADMIN_PASSWORD",
    "HULLWISE_APP_PASSWORD",
    "DATABASE_SUPERUSER_URL",
    "HULLWISE_DATABASES",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_DEMO_URL",
    "NEXT_PUBLIC_CONTACT_EMAIL",
    "NEXT_PUBLIC_CONTACT_WEBHOOK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
